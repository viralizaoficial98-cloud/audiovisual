# URL pública do site (usada em canonical, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://audiovisual.viralizahost.com

# Opcional: webhook que recebe os pedidos do formulário de contacto (ex.: n8n, Make, Zapier, Formspree).
# Sem esta variável, o formulário encaminha a mensagem para o WhatsApp/e-mail do cliente.
CONTACT_WEBHOOK_URL=
